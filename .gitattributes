# Normalizacion de finales de linea
* text=auto

# Scripts que DEBEN conservar LF (se ejecutan en Linux/CI)
gradlew text eol=lf
*.sh text eol=lf

# Scripts de Windows con CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binarios: nunca convertir
*.jar binary
*.png binary
*.ico binary
*.icns binary
*.msi binary
*.apk binary
*.keystore binary
*.jks binary
