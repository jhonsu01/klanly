# ===== Base =====
# Neon Postgres (usa la connection string CON -pooler para serverless)
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/klanly?sslmode=require

# Secreto para firmar JWT de sesion (genera uno con: openssl rand -hex 32)
JWT_SECRET=cambia-esto-por-un-hex-de-64-caracteres

# Secreto HMAC para firmar la integridad de las ordenes de pago (reciclado de rifas)
PAYMENTS_HMAC_SECRET=otro-hex-de-64-caracteres

# Origen publico de la app (para redirects de checkout)
APP_URL=https://klanly.vercel.app

# ===== Wompi (pasarela LATAM) =====
WOMPI_ENV=test                 # test | prod
WOMPI_PUBLIC_KEY=pub_test_xxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxx
WOMPI_EVENTS_SECRET=test_events_xxx    # valida la firma de los webhooks

# ===== (opcional) Vercel Blob para comprobantes de pago manual =====
BLOB_READ_WRITE_TOKEN=
