# Puente de delegación: Claude Code → ZCode (GLM-5.2) vía execution/zai_delegate.mjs
# Copia este archivo como .env (en esta misma carpeta) y llena la key.
#
# IMPORTANTE: el endpoint lo fijó el usuario, NO cambiarlo.
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
#
# La key la pone el usuario (no se commitea). Consíguela en z.ai.
ZAI_API_KEY=
#
# Modelo coding a usar para delegar (ajustable según tu plan de Z.ai).
ZAI_MODEL=glm-5.2
